<% breadcrumb :checkin_fields %>

<% filters = [
      { attr: :permission_eq, label: "Added By", as: :select, collection: CheckinField.permissions.keys.map { |p| [ p.humanize, p ] } }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Checkin Fields",
      collection: @checkin_fields,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", permission: "Permission", updated_at: "Last Updated" },
      new_path: (new_checkin_field_path if policy(CheckinField).new?),
      new_label: "Checkin Field"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @checkin_fields, noun: "checkin field" %>

  <% if @checkin_fields.any? %>

    <div id="checkin_fields" class="row">
      <% @checkin_fields.each do |checkin_field| %>
        <div class="col-md-3">
          <%= render checkin_field %>
        </div>
      <% end %>
    </div>

  <%= paginate @checkin_fields %>
  <% else %>
    <%= render "shared/no_results", noun: "checkin field", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
