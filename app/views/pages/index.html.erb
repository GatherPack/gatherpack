<% breadcrumb :pages %>

<% filters = [
      { attr: :team_id_eq, label: "Team", as: :select, collection: Team.all }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Pages",
      collection: @pages,
      primary: { attr: :title_or_content_cont, placeholder: "Search title and content…" },
      filters: filters,
      sorts: { title: "Title", updated_at: "Last Updated" },
      new_path: (new_page_path if policy(Page).new?),
      new_label: "Page"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @pages, noun: "page" %>

  <% if @pages.any? %>

    <div id="pages" class="row">
      <% @pages.each do |page| %>
        <div class="col-md-3">
          <%= render page %>
        </div>
      <% end %>
    </div>

    <%= paginate @pages %>
  <% else %>
    <%= render "shared/no_results", noun: "page", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
