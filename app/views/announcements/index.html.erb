<% breadcrumb :announcements %>

<% filters = [
      { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Announcements",
      collection: @announcements,
      primary: { attr: :title_or_content_i_cont, placeholder: "Search title and content…" },
      filters: filters,
      sorts: { title: "Title", start_time: "Start Time", end_time: "End Time", updated_at: "Last Updated" },
      new_path: (new_announcement_path if policy(Announcement).new?),
      new_label: "Announcement"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @announcements, noun: "announcement" %>

  <% if @announcements.any? %>

    <div id="announcements" class="row">
      <% @announcements.each do |announcement| %>
        <div class="col-12 col-md-6">
          <div class="card" id="<%= dom_id announcement %>">
            <div class="card-header">
              <% if announcement.team %>
                <%= link_to i(announcement.team.team_type.icon), team_path(announcement.team), class: "badge rounded-pill", style: "background-color:#{announcement.team.color};color:#{contrasting_color(announcement.team.color)}", "data-turbo": "false", title: "Posted in #{announcement.team.name}" %>
              <% end %>
              <%= link_to announcement.title, announcement, "data-turbo": "false" %>
            </div>
            <div class="card-body">
              <%= md announcement.content.truncate(80) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <%= paginate @announcements %>
  <% else %>
    <%= render "shared/no_results", noun: "announcement", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
