<% breadcrumb :tokens %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Tokens",
      collection: @tokens,
      primary: { attr: :tokenable_of_Person_type_display_name_cont,
                 placeholder: "Search by person…" },
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: (new_token_path if policy(Token).new?),
      new_label: "Token"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @tokens, noun: "token" %>

  <% if @tokens.any? %>

    <div id="tokens" class="row">
      <% @tokens.each do |token| %>
        <div class="col-md-3">
          <%= render token %>
        </div>
      <% end %>
    </div>

    <%= paginate @tokens %>
  <% else %>
    <%= render "shared/no_results", noun: "token", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
