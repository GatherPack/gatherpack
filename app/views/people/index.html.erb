<% breadcrumb :people %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "People",
      collection: @people,
      primary: { attr: :display_name_cont, placeholder: "Search by name…" },
      filters: [],
      sorts: { last_name: "Last Name", first_name: "First Name",
               birthday: "Age", updated_at: "Last Updated" },
      new_path: (new_person_path if policy(Person).new?),
      new_label: "New Person"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: [], collection: @people, noun: "person" %>

  <% if @people.any? %>
    <div id="people" class="row">
      <% @people.each do |person| %>
        <div class="col-md-3">
          <%= render person %>
        </div>
      <% end %>
    </div>

    <%= paginate @people %>
  <% else %>
    <%= render "shared/no_results", noun: "person", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
