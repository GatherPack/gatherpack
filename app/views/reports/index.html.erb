<% breadcrumb :reports %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Reports",
      collection: @reports,
      primary: { attr: :name_i_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_report_path if policy(Report).new?),
      new_label: "Report"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @reports, noun: "report" %>

  <% if @reports.any? %>

    <div id="reports" class="row">
      <% @reports.each do |report| %>
        <div class="col-md-3">
          <%= render report %>
        </div>
      <% end %>
    </div>

    <%= paginate @reports %>
  <% else %>
    <%= render "shared/no_results", noun: "report", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
