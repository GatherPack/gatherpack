<% breadcrumb :audit_logs %>

<% filters = [
      { attr: :event_eq, label: "Event", as: :select, collection: [ "create", "update", "destroy" ] },
      { attr: :item_type_eq, label: "Model", as: :select, collection: AuditLog.distinct.order(:item_type).pluck(:item_type).compact },
      { attr: :whodunnit_eq, label: "Whodunnit", as: :searching_combobox, opts: { scope: "users" } }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Audit Log",
      collection: @logs,
      primary: nil,
      filters: filters,
      sorts: { whodunnit: "Whodunnit", item_type: "Model", event: "Event", created_at: "Last Updated" },
      new_path: nil
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @logs, noun: "entry" %>

  <% if @logs.any? %>

    <div id="logs" class="row">
      <% @logs.each do |log| %>
        <div class="col-md-3">
          <%= render log %>
        </div>
      <% end %>
    </div>

  <%= paginate @logs %>
  <% else %>
    <%= render "shared/no_results", noun: "entry", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
