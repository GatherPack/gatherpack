<% breadcrumb :shortcuts %>

<% filters = [
        { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Shortcuts",
      collection: @shortcuts,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_shortcut_path if policy(Shortcut).new?),
      new_label: "Shortcut"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @shortcuts, noun: "shortcut" %>

  <% if @shortcuts.any? %>

    <div id="shortcuts" class="row">
      <% @shortcuts.each do |shortcut| %>
        <div class="col-md-3">
          <%= render shortcut %>
        </div>
      <% end %>
    </div>

    <%= paginate @shortcuts %>
  <% else %>
    <%= render "shared/no_results", noun: "shortcut", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
