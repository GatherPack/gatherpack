<% breadcrumb :hooks %>

<% filters = [
      { attr: :event_eq, label: "Event", as: :select, collection: Hook.catalog }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Hooks",
      collection: @hooks,
      primary: { attr: :name_i_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", event: "Event", updated_at: "Last Updated" },
      new_path: (new_hook_path if policy(Hook).new?),
      new_label: "Hook"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @hooks, noun: "hook" %>

  <% if @hooks.any? %>

    <div id="hooks" class="row">
      <% @hooks.each do |hook| %>
        <div class="col-md-3">
          <%= render hook %>
        </div>
      <% end %>
    </div>

  <%= paginate @hooks %>
  <% else %>
    <%= render "shared/no_results", noun: "hook", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
