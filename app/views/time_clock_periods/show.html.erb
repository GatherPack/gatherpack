<% breadcrumb @time_clock_period %>

<div class="card">
  <div class="card-header">
    <h1><%= @time_clock_period.identifier_name %></h1>
  </div>
  <% if @time_clock_period.total_hours > 0 %>
    <div class="card-body">
      <p>
        <%= pluralize(@time_clock_period.total_hours, "hour") %> potential assigned hours from <%= pluralize(@time_clock_period.events.count, "event") %>.
        <% if @time_clock_period.available_hours > 0 %>
          <%= pluralize(@time_clock_period.available_hours, "hour") %> have accumulated so far.
          <% end %>
      </p>
    </div>
  <% end %>
  <div class="card-footer">
    <%= link_to "Back to Time Clock", time_clock_punches_path, class: "btn btn-success" %>
    <%= link_to "Period Summary", summary_time_clock_period_path(@time_clock_period), class: "btn btn-info" %>
    <%= link_to "Edit", edit_time_clock_period_path(@time_clock_period), class: "btn btn-warning" if policy(@time_clock_period).edit? %>
    <%= link_to "Delete", @time_clock_period, class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } if policy(@time_clock_period).destroy? %>
  </div>
</div>

<% filters = [
        { attr: :start_time_gteq, label: "Starting After", opts: { input_html: { type: "datetime-local" } } },
        { attr: :end_time_lteq, label: "Ending Before", opts: { input_html: { type: "datetime-local" } } }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      url: @time_clock_period,
      title: "Punches",
      collection: @time_clock_punches,
      primary: { attr: :person_display_name_cont, placeholder: "Search by person…" },
      filters: filters,
      sorts: { start_time: "Start Time", end_time: "End Time", updated_at: "Last Updated" },
      new_path: nil
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @time_clock_punches, noun: "punch" %>

  <% if @time_clock_punches.any? %>

    <div class="row">
      <div class="col">
        <%= render "time_clock_punches/time_clock_punches" %>
      </div>
    </div>

    <%= paginate @time_clock_punches %>
  <% else %>
    <%= render "shared/no_results", noun: "punch", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
