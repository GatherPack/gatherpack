<% breadcrumb :time_clock_periods %>

<% filters = [
        { attr: :start_time_gteq, label: "Starting After", opts: { input_html: { type: :date } } },
        { attr: :end_time_lteq, label: "Ending Before", opts: { input_html: { type: :date } } },
        { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Time Clock Periods",
      collection: @time_clock_periods,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", start_time: "Start Time", end_time: "End Time", updated_at: "Last Updated" },
      new_path: (new_time_clock_period_path if policy(TimeClockPeriod).new?),
      new_label: "Time Clock Period"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @time_clock_periods, noun: "period" %>

  <% if @time_clock_periods.any? %>

    <div id="time_clock_periods" class="row">
      <% @time_clock_periods.each do |time_clock_period| %>
        <div class="col-md-3">
          <%= render time_clock_period %>
        </div>
      <% end %>
    </div>

    <%= paginate @time_clock_periods %>
  <% else %>
    <%= render "shared/no_results", noun: "period", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
