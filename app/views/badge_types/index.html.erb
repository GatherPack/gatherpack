<% breadcrumb :badge_types %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Badge Types",
      collection: @badge_types,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_badge_type_path if policy(BadgeType).new?),
      new_label: "Badge Type"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @badge_types, noun: "badge type" %>

  <% if @badge_types.any? %>

    <div id="badge_types" class="row">
      <% @badge_types.each do |badge_type| %>
        <div class="col-md-3">
          <%= render badge_type %>
        </div>
      <% end %>
    </div>

  <%= paginate @badge_types %>
  <% else %>
    <%= render "shared/no_results", noun: "badge type", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
