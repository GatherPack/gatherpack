<% breadcrumb :variables %>

<% filters = [
      { attr: :klass_eq, label: "Type", as: :select, collection: Variable::TYPES }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Variables",
      collection: @variables,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", klass: "Klass", raw_value: "Value", updated_at: "Last Updated" },
      new_path: (new_variable_path if policy(Variable).new?),
      new_label: "Variable"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @variables, noun: "variable" %>

  <% if @variables.any? %>

    <div id="variables" class="row">
      <% @variables.each do |variable| %>
        <div class="col-md-3">
          <%= render variable %>
        </div>
      <% end %>
    </div>

    <%= paginate @variables %>
  <% else %>
    <%= render "shared/no_results", noun: "variable", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
