<% breadcrumb :events %>

<%
  filters = [
    { attr: :location_i_cont, label: "Location", as: :string },
    { attr: :event_type_id_eq, label: "Event Type", as: :select, collection: EventType.all },
    { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) },
    { attr: :time_clock_period_id_eq, label: "Time Clock Period", as: :select,
      collection: policy_scope(TimeClockPeriod) }
  ]
%>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Events",
      collection: @events,
      primary: { attr: :name_or_location_i_cont, placeholder: "Search name and location…" },
      filters: filters,
      sorts: { name: "Name", start_time: "Start Time", end_time: "End Time",
               updated_at: "Last Updated" },
      new_path: (new_event_path if policy(Event).new?),
      new_label: "New Event"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @events, noun: "event" %>

  <% if @events.any? %>
    <div id="events" class="row">
      <% @events.each do |event| %>
        <div class="col-md-3">
          <%= render event %>
        </div>
      <% end %>
    </div>

    <%= paginate @events %>
  <% else %>
    <%= render "shared/no_results", noun: "event", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
