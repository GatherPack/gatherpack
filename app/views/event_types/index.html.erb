<% breadcrumb :event_types %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Event Types",
      collection: @event_types,
      primary: { attr: :name_i_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_event_type_path if policy(EventType).new?),
      new_label: "Event Type"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @event_types, noun: "event type" %>

  <% if @event_types.any? %>

    <div id="event_types" class="row">
      <% @event_types.each do |event_type| %>
        <div class="col-md-3">
          <%= render event_type %>
        </div>
      <% end %>
    </div>

  <%= paginate @event_types %>
  <% else %>
    <%= render "shared/no_results", noun: "event type", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
