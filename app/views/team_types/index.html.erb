<% breadcrumb :team_types %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Team Types",
      collection: @team_types,
      primary: { attr: :name_i_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", icon: "Icon", updated_at: "Last Updated" },
      new_path: (new_team_type_path if policy(TeamType).new?),
      new_label: "Team Type"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @team_types, noun: "team type" %>

  <% if @team_types.any? %>

    <div id="team_types" class="row">
      <% @team_types.each do |team_type| %>
        <div class="col-md-3">
          <%= render team_type %>
        </div>
      <% end %>
    </div>

    <%= paginate @team_types %>
  <% else %>
    <%= render "shared/no_results", noun: "team type", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
