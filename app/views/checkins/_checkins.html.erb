<%= render layout: "shared/filter_bar", locals: {
      q: q,
      url: event_url,
      title: "Checkins",
      collection: checkins,
      primary: { attr: :person_display_name_cont, placeholder: "Search by name…" },
      filters: [],
      sorts: {},
      new_path: (new_event_checkin_path(event) if policy(@checkin).create?),
      new_label: "Check Someone In",
      actions: capture do %>
        <% unless policy(@checkin).create? %>
          <span class="btn btn-success disabled">Check In Locked</span>
        <% end %>
      <% end
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: q, filters: [], collection: checkins, noun: "checkin" %>

  <% if checkins.any? %>
    <div id="checkins" class="row">
      <% checkins.each do |checkin| %>
        <div class="col-6 col-md-2">
          <%= render checkin %>
        </div>
      <% end %>
    </div>

    <%= paginate checkins %>
  <% else %>
    <%= render "shared/no_results", noun: "checkin", filtered: any_filters_applied?(q) %>
  <% end %>
<% end %>
