<%= render "teams/show_shared" %>

<div data-controller="member-manage">
  <% membership_filters = [
     { param: :member_type, label: "Membership Type", default: "",
       collection: [ [ "All", "" ], [ "Direct Members", "direct" ],
                     [ "Parent Managers", "parent_manager" ],
                     [ "Child Team Members", "child_member" ] ] }
   ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @people_q,
      url: team_memberships_path(@team),
      title: "All People",
      collection: @people,
      primary: { attr: :display_name_cont, placeholder: "Search by name…" },
      filters: membership_filters,
      sorts: {},
      frame: "people_results",
      extra_params: [ :member_type ],
      new_path: (new_team_membership_path(@team) if policy(@team).manage_members?),
      new_label: "Add Member",
      actions: capture do %>
        <% if policy(@team).manage_members? %>
          <button type="button" class="btn btn-primary" data-action="member-manage#toggle">
            <span data-member-manage-target="label">Manage Members</span>
          </button>
        <% end %>
      <% end
    } do |f| %>
<% end %>

  <%= turbo_frame_tag "people_results", data: { turbo_action: "advance" } do %>
    <%= render "shared/results_header", q: @people_q, filters: membership_filters, collection: @people, noun: "person" %>

    <div id="people_grid" class="row">
      <% @people.each do |person| %>
        <% membership = person.memberships.find_by(team: @team) %>
        <% if membership %>
          <div class="col-6 col-md-2" id="<%= dom_id membership %>">
            <%= render "memberships/card", membership: membership %>
          </div>
        <% else %>
          <div class="col-6 col-md-2">
            <%= render person %>
          </div>
        <% end %>
      <% end %>
    </div>
    <%= paginate @people, param_name: :people_page %>

    <% if @people.none? %>
      <%= render "shared/no_results", noun: "person", filtered: any_filters_applied?(@people_q, [ :member_type ]) %>
    <% end %>
  <% end %>
</div>
