<% breadcrumb :ledger_tags %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Ledger Tags",
      collection: @ledger_tags,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_ledger_tag_path if policy(LedgerTag).new?),
      new_label: "Ledger Tag"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @ledger_tags, noun: "ledger tag" %>

  <% if @ledger_tags.any? %>

    <div id="ledger_tags" class="row">
      <% @ledger_tags.each do |ledger_tag| %>
        <div class="col-md-3">
          <%= render ledger_tag %>
        </div>
      <% end %>
    </div>

  <%= paginate @ledger_tags %>
  <% else %>
    <%= render "shared/no_results", noun: "ledger tag", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
