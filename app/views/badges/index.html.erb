<% breadcrumb :badges %>

<% filters = [
        { attr: :badge_type_id_eq, label: "Badge Type", as: :select, collection: BadgeType.all },
        { attr: :team_id_eq, label: "Team", as: :select, collection: Team.all }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Badges",
      collection: @badges,
      primary: { attr: :name_or_description_or_short_cont, placeholder: "Search badges…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_badge_path if policy(Badge).new?),
      new_label: "Badge"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @badges, noun: "badge" %>

  <% if @badges.any? %>

    <div id="badges" class="row">
      <% @badges.each do |badge| %>
        <div class="col-md-3">
          <%= render badge %>
        </div>
      <% end %>
    </div>

  <%= paginate @badges %>
  <% else %>
    <%= render "shared/no_results", noun: "badge", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
