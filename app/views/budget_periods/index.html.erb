<% breadcrumb :budget_periods %>

<% filters = [
        { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Budget Periods",
      collection: @budget_periods,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", starts_at: "Start", ends_at: "End", updated_at: "Last Updated" },
      new_path: (new_budget_period_path if policy(BudgetPeriod).new?),
      new_label: "Budget Period"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @budget_periods, noun: "budget period" %>

  <% if @budget_periods.any? %>

    <div id="budget_periods" class="row">
      <% @budget_periods.each do |budget_period| %>
        <div class="col-md-3">
          <%= render budget_period %>
        </div>
      <% end %>
    </div>

  <%= paginate @budget_periods %>
  <% else %>
    <%= render "shared/no_results", noun: "budget period", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
