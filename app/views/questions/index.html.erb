<% breadcrumb :questions %>

<% filters = [
        { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) },
        { attr: :closed_eq, label: "Status", as: :select, default: false,
        collection: [ [ "Open", false ], [ "Closed", true ] ], include_blank: "All" }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Questions",
      collection: @questions,
      primary: { attr: :title_i_cont, placeholder: "Search by title…" },
      filters: filters,
      sorts: { created_at: "Newest", updated_at: "Most Active" },
      new_path: (new_question_path if policy(Question).create?),
      new_label: "Question"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @questions, noun: "question" %>

  <% if @questions.any? %>

    <div id="questions">
      <% @questions.each do |question| %>
        <div class="card mb-3" id="<%= dom_id question %>">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div>
              <% if question.team %>
                <%= link_to i(question.team.team_type.icon), team_path(question.team), class: "badge rounded-pill", style: "background-color:#{question.team.color};color:#{contrasting_color(question.team.color)}", "data-turbo": "false", title: question.team.name %>&nbsp;
              <% end %>
              <%= link_to question.title, question, "data-turbo": "false" %>
              <% if question.closed? %>
                <span class="badge bg-secondary">Closed</span>
              <% end %>
            </div>
            <div class="text-muted small">
              <i class="fa-regular fa-comment"></i> <%= question.replies.size %>
              &middot;
              <%= time_ago_in_words(question.created_at) %> ago
            </div>
          </div>
          <div class="card-body">
            <small class="text-muted">
              Asked by <%= question.person.display_name %>
              <% if question.team %>
                in <%= question.team.name %>
              <% end %>
            </small>
          </div>
        </div>
      <% end %>
    </div>

    <%= paginate @questions %>
  <% else %>
    <%= render "shared/no_results", noun: "question", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
