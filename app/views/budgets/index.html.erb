<% breadcrumb :budgets %>

<% filters = [
        { attr: :budget_period_id_eq, label: "Budget Period", as: :select, collection: policy_scope(BudgetPeriod) }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Budgets",
      collection: @budgets,
      primary: nil,
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: (new_budget_path if policy(Budget).new?),
      new_label: "Budget"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @budgets, noun: "budget" %>

  <% if @budgets.any? %>

    <div id="budgets" class="row">
      <% @budgets.each do |budget| %>
        <div class="col-md-3">
          <%= render budget %>
        </div>
      <% end %>
    </div>

  <%= paginate @budgets %>
  <% else %>
    <%= render "shared/no_results", noun: "budget", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
