<% breadcrumb :ledger_entry_links %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Ledger Entry Links",
      collection: @ledger_entry_links,
      primary: nil,
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: (new_ledger_entry_link_path if policy(LedgerEntryLink).new?),
      new_label: "Ledger Entry Link"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @ledger_entry_links, noun: "link" %>

  <% if @ledger_entry_links.any? %>

    <div id="ledger_entry_links" class="row">
      <% @ledger_entry_links.each do |ledger_entry_link| %>
        <div class="col-md-3">
          <%= render ledger_entry_link %>
        </div>
      <% end %>
    </div>

  <%= paginate @ledger_entry_links %>
  <% else %>
    <%= render "shared/no_results", noun: "link", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
