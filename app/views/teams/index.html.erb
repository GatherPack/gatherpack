<% breadcrumb :teams %>

<%
  filters = [
    { attr: :team_type_id_eq, label: "Team Type", as: :select, collection: TeamType.all },
    { attr: :top_level, label: "Top Level", as: :select,
      collection: [ [ "Only Top Level Teams", true ] ] },
    # Read straight off params by TeamsController; "My Teams" is the default.
    { param: :filter, label: "Show", default: "",
      collection: [ [ "My Teams", "" ], [ "All Teams", "all" ] ] }
  ]
%>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Teams",
      collection: @teams,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { team_type_name: "Team Type", name: "Name", updated_at: "Last Updated" },
      new_path: (new_team_path if policy(Team).new?),
      new_label: "New Team",
      extra_params: [ :filter ]
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @teams, noun: "team" %>

  <% if @teams.any? %>
    <div id="teams">
      <% @teams.each do |team| %>
        <%= render team %>
      <% end %>
    </div>

    <%= paginate @teams %>
  <% else %>
    <%= render "shared/no_results", noun: "team", filtered: any_filters_applied?(@q, [ :filter ]) %>
  <% end %>
<% end %>
