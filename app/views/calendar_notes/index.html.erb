<% breadcrumb :calendar_notes %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Calendar Notes",
      collection: @calendar_notes,
      primary: { attr: :name_i_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", start_time: "Start Time", end_time: "End Time", updated_at: "Last Updated" },
      new_path: (new_calendar_note_path if policy(CalendarNote).new?),
      new_label: "Calendar Note"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @calendar_notes, noun: "calendar note" %>

  <% if @calendar_notes.any? %>

    <div id="calendar_notes" class="row">
      <% @calendar_notes.each do |calendar_note| %>
        <div class="col-md-3">
          <%= render calendar_note %>
        </div>
      <% end %>
    </div>

  <%= paginate @calendar_notes %>
  <% else %>
    <%= render "shared/no_results", noun: "calendar note", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
