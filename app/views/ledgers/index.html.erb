<% breadcrumb :ledgers %>

<% filters = [
      { attr: :team_id_eq, label: "Team", as: :select, collection: policy_scope(Team) }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Ledgers",
      collection: @ledgers,
      primary: { attr: :name_cont, placeholder: "Search by name…" },
      filters: filters,
      sorts: { name: "Name", updated_at: "Last Updated" },
      new_path: (new_ledger_path if policy(Ledger).new?),
      new_label: "Ledger"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @ledgers, noun: "ledger" %>

  <% if @ledgers.any? %>

    <div id="ledgers" class="row">
      <% @ledgers.each do |ledger| %>
        <div class="col-md-3">
          <%= render ledger %>
        </div>
      <% end %>
    </div>

  <%= paginate @ledgers %>
  <% else %>
    <%= render "shared/no_results", noun: "ledger", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
