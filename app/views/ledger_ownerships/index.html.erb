<% breadcrumb :ledger_ownerships, @ledger %>

<% filters = [
        { attr: :ledger_id_eq, label: "Ledger", as: :select, collection: policy_scope(Ledger) }
      ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Ledger Ownerships",
      collection: @ledger_ownerships,
      primary: nil,
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: (new_ledger_ownership_path if policy(LedgerOwnership).new?),
      new_label: "Ledger Ownership"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @ledger_ownerships, noun: "ownership" %>

  <% if @ledger_ownerships.any? %>

    <div id="ledger_ownerships" class="row">
      <% @ledger_ownerships.each do |ledger_ownership| %>
        <div class="col-md-3">
          <%= render ledger_ownership %>
        </div>
      <% end %>
    </div>

  <%= paginate @ledger_ownerships %>
  <% else %>
    <%= render "shared/no_results", noun: "ownership", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
