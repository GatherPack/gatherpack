<% breadcrumb :relationship_types %>

<% filters = [
      { attr: :permission_eq, label: "Added By", as: :select, collection: RelationshipType.permissions.keys.map { |p| [ p.humanize, p ] } }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Relationship Types",
      collection: @relationship_types,
      primary: { attr: :child_label_or_parent_label_cont, placeholder: "Search by label…" },
      filters: filters,
      sorts: { parent_label: "Parent Label", child_label: "Child Label", permission: "Permission", updated_at: "Last Updated" },
      new_path: (new_relationship_type_path if policy(RelationshipType).new?),
      new_label: "Relationship Type"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @relationship_types, noun: "relationship type" %>

  <% if @relationship_types.any? %>

    <div id="relationship_types" class="row">
      <% @relationship_types.each do |relationship_type| %>
        <div class="col-md-3">
          <%= render relationship_type %>
        </div>
      <% end %>
    </div>

    <%= paginate @relationship_types %>
  <% else %>
    <%= render "shared/no_results", noun: "relationship type", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
