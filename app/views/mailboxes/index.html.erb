<% breadcrumb :mailboxes %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "Mailboxes",
      collection: @mailboxes,
      primary: { attr: :address_cont, placeholder: "Search by address…" },
      filters: filters,
      sorts: { address: "Address", updated_at: "Last Updated" },
      new_path: (new_mailbox_path if policy(Mailbox).new?),
      new_label: "Mailbox"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @mailboxes, noun: "mailbox" %>

  <% if @mailboxes.any? %>

    <div id="mailboxes" class="row">
      <% @mailboxes.each do |mailbox| %>
        <div class="col-md-3">
          <%= render mailbox %>
        </div>
      <% end %>
    </div>

  <%= paginate @mailboxes %>
  <% else %>
    <%= render "shared/no_results", noun: "mailbox", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
