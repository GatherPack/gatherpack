<% breadcrumb @mailbox %>

<% filters = [] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      url: @mailbox,
      title: @mailbox.identifier_name,
      collection: @mailbox_messages,
      primary: { attr: :subject_or_body_or_from_cont, placeholder: "Search messages…" },
      filters: filters,
      sorts: { from: "Address", subject: "Subject", updated_at: "Last Updated" },
      new_path: (new_mailbox_mailbox_message_path(@mailbox) if policy(MailboxMessage).new?),
      new_label: "Message",
      actions: capture do %>
        <%= link_to "Edit", edit_mailbox_path(@mailbox), class: "btn btn-warning" if policy(Mailbox).edit? %>
        <%= link_to "Delete", @mailbox, class: "btn btn-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } if policy(Mailbox).destroy? %>
      <% end
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @mailbox_messages, noun: "message" %>

  <% if @mailbox_messages.any? %>

    <div id="mailbox_messages" class="row">
      <% @mailbox.messages.each do |mailbox_message| %>
        <div class="col-md-3">
          <%= render mailbox_message %>
        </div>
      <% end %>
    </div>

    <%= paginate @mailbox_messages %>
  <% else %>
    <%= render "shared/no_results", noun: "message", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
