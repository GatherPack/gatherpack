<% breadcrumb :badge_assignments, @badge %>

<% filters = [
      { attr: :person_id_eq, label: "Person", as: :select, collection: policy_scope(Person),
        opts: { label_method: :identifier_name } }
    ] %>

<%= render layout: "shared/filter_bar", locals: {
      q: @q,
      url: badge_badge_assignments_path(@badge),
      title: "#{@badge.name} Assignments",
      collection: @badge_assignments,
      primary: nil,
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: (new_badge_badge_assignment_path(@badge) if policy(@badge).update?),
      new_label: "Assignment"
    } do |f| %>
<% end %>

<%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%= render "shared/results_header", q: @q, filters: filters, collection: @badge_assignments, noun: "badge assignment" %>

  <% if @badge_assignments.any? %>

    <div id="badge_assignments" class="row">
      <% @badge_assignments.each do |badge_assignment| %>
        <div class="col-md-3">
          <%= render badge_assignment %>
        </div>
      <% end %>
    </div>

  <%= paginate @badge_assignments %>
  <% else %>
    <%= render "shared/no_results", noun: "badge assignment", filtered: any_filters_applied?(@q) %>
  <% end %>
<% end %>
