<div class="card" id="<%= dom_id badge_assignment %>">
  <div class="card-header">
    <%= link_to badge_assignment.person.identifier_name, [ badge_assignment.badge, badge_assignment ], 'data-turbo': false %>
  </div>
  <div class="card-body">
    <%= image_tag get_avatar_url_512(badge_assignment.person.avatar), class: "person-img" %>
    <p class="mb-0 mt-2"><strong>Earned:</strong> <%= badge_assignment.earned_at&.strftime("%b %-d, %Y") %></p>
  </div>
</div>
