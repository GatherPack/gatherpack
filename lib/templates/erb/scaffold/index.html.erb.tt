<%% breadcrumb :<%= plural_table_name %> %>

<%% filters = [] %>

<%%= render layout: "shared/filter_bar", locals: {
      q: @q,
      title: "<%= human_name.pluralize.titleize %>",
      collection: @<%= plural_table_name %>,
      primary: nil,
      filters: filters,
      sorts: { updated_at: "Last Updated" },
      new_path: <%= new_helper(type: :path) %>,
      new_label: "<%= human_name.titleize %>"
    } do |f| %>
<%% end %>

<%%= turbo_frame_tag "results", data: { turbo_action: "advance" } do %>
  <%%= render "shared/results_header", q: @q, filters: filters,
        collection: @<%= plural_table_name %>, noun: "<%= human_name.downcase %>" %>

  <%% if @<%= plural_table_name %>.any? %>
    <div id="<%= plural_table_name %>" class="row">
      <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
        <div class="col-md-3">
          <%%= render <%= singular_table_name %> %>
        </div>
      <%% end %>
    </div>

    <%%= paginate @<%= plural_table_name %> %>
  <%% else %>
    <%%= render "shared/no_results", noun: "<%= human_name.downcase %>",
          filtered: any_filters_applied?(@q) %>
  <%% end %>
<%% end %>
